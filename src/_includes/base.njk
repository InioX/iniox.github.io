{# src/_includes/base.njk #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link
    rel="icon"
    type="image/x-icon"
    href="https://avatars.githubusercontent.com/u/81521595"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/prism.css' | url }}">
  {% set currentTheme = theme or item.theme or project.theme or "blue.css" %}
  {#
    {% if tags and "blog" in tags or page.url.startsWith('/blogs/') %}
      {% set currentTheme = "blue.css" %}
    {% endif %}
  #}
  <link rel="stylesheet" href="{{ ('/css/colorschemes/' ~ currentTheme) | url }}">
  <script src="{{ '/js/script.js' | url }}" defer></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
  <script>
    window.Prism = window.Prism || {};
    window.Prism.manual = true; // optional, prevents auto-highlighting before plugins load
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      if (window.Prism) {
        Prism.highlightAll();
      }
    });
  </script>
</head>
<body>
<nav class="navbar">
    <ul class="nav-links">
      <li class="nav-item">
        <a href="/home/" {% if page.url.startsWith('/home/') %}class="active" aria-current="page"{% endif %}>
          <span class="nav-icon">
            {% include "icons/navbar/home.svg" %}
          </span>
          <span class="nav-text">Home</span>
        </a>
        <hr/>
      </li>
      <li class="nav-item">
        <a href="/docs/" {% if page.url.startsWith('/docs/') %}class="active" aria-current="page"{% endif %}>
          <span class="nav-icon">
            {% include "icons/navbar/docs.svg" %}
          </span>
          <span class="nav-text">Docs</span>
        </a>
        <hr/>
      </li>
      <li class="nav-item">
        <a href="/blogs/" {% if page.url.startsWith('/blogs/') %}class="active" aria-current="page"{% endif %}>
          <span class="nav-icon">
            {% include "icons/navbar/blogs.svg" %}
          </span>
          <span class="nav-text">Blogs</span>
        </a>
        <hr/>
      </li>
    </ul>
  </nav>

  <div class="header">
    <div class="header-left">
      <a href="https://www.github.com/InioX/" class="btn btn-filled">
        <span class="btn-icon">
          {% include "icons/github.svg" %}
        </span>

        Profile
      </a>

      <a href="/home/contact" class="btn btn-tonal">
        <span class="btn-icon">
          {% include "icons/contact.svg" %}
        </span>

        Contact
      </a>
    </div>

    <div class="header-right">
      <a href="https://www.github.com/InioX/iniox.github.io" class="btn">
        Open Repo
        <span class="btn-icon btn-icon-trailing">
          {% include "icons/contact.svg" %}
        </span>
      </a>
    </div>
  </div>

  <main>{{ content | safe }}</main>
</body>
</html>
