---
layout: base.njk
title: Docs
theme: "purple.css"
---
<div class="page-content">
<div class="centered">

<img
    src="/images/purple.gif"
    alt="Docs Header"
    class="header-image"
/>

<h1 class="page-header-text">Welcome to the documentation!</h1>
<p>You can read more about the projects below</p>

{% for p in collections.docProjects %}
    <div class="project-container">
        
        {% if p.image %}
            <img
            src="{{ p.image }}"
            alt="{{ p.name }} Header"
            class="project-header"
            />
        {% endif %}

        <h2 data-no-copy>{{ p.name }}</h2>

        <p>{{ p.desc }}</p>

        <a href="{{ '/docs/' ~ (p.name | slugify) ~ '/' | url }}" class="btn btn-filled">Documentation</a>
      </div>
{% endfor %}
</div>
</div>
