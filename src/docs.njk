---
layout: base.njk
title: Docs
theme: "purple.css"
---
<div class="page-content">
<div class="centered">

<img
    src="{{ '/images/purple.gif' | url }}"
    alt="Docs Header"
    class="header-image"
/>

<h1 class="page-header-text">Welcome to the documentation!</h1>
<p>You can read more about the projects below</p>

{% for p in collections.docProjects %}
    <div class="project-container blog-container">
        
        <div class="project-info-group">
            {% if p.image %}
                <div>
                <img
                    src="{{ p.image | url }}"
                    alt="{{ p.name }} Header"
                    class="project-header"
                />
                </div>
            {% endif %}

            <div class="project-text-group">
                <h4 class="project-title">{{ p.name }}</h4>
                <p class="project-desc">{{ p.desc }}</p>
            </div>
        </div>

        <div class="project-button-group">
            <a href="{{ '/docs/' ~ (p.name | slugify) ~ '/' | url }}" class="btn btn-filled">Documentation</a>
            <a href="{{ p.link }}" class="btn btn-tonal">Repo</a>
        </div>
      </div>
{% endfor %}
</div>
</div>
