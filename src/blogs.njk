---
layout: base.njk
title: Blogs
theme: "blue.css"
---
<div class="page-content">
<div class="centered">

<img
    src="{{ '/images/blue.gif' | url }}"
    alt="Blogs Header"
    class="header-image"
/>

<h1 class="page-header-text">Welcome to the blogs!</h1>
<p>You can read some of my blogs below</p>

{% for post in collections.blog %}
    <div class="project-container blog-container">
      <div>
        <h4 class="blog-title">{{ post.data.title }}</h4>
        <p class="blog-description">{{ post.data.desc }}</p>
        <p class="blog-date">{{ page.date.toUTCString() }}</p>
      </div>

      <a href="{{ post.url | url }}" class="btn btn-filled">Read</a>
    </div>
{% endfor %}

</div>
</div>
