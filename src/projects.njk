---
layout: base.njk
title: About
permalink: "/home/projects/"
theme: "green.css"
---

<div class="page-content">
<div class="centered">

{% include "index-header.njk" %}

<h1>My projects</h1>

{% for p in projects %}
    <div class="project-container blog-container">
      <div>
        <h4 class="blog-title">{{ p.name }}</h4>
        <p class="blog-description">{{ p.desc }}</p>
      </div>

      <div class="project-button-group">
        {% if p.sections and p.sections.length > 0 %}
        <a href="{{ '/docs/' ~ (p.name | slugify) ~ '/' | url }}" class="btn btn-filled">
            <span class="btn-icon">
              {% include "icons/navbar/docs.svg" %}
            </span>
            Docs
          </a>
        {% endif %}

        <a href="{{ p.link }}" class="btn btn-tonal">
          <span class="btn-icon">
            {% include "icons/github.svg" %}
          </span>
          Repo
        </a>
      </div>
    </div>
{% endfor %}

</div>
</div>
